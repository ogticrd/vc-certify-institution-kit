# =============================================================================
# Kit de implementación Inji Certify — República Dominicana
# Copie este archivo a .env y complete los valores antes de ejecutar ./install.sh
# =============================================================================

# --- TLS y URL pública ---
# domain: dominio institucional con Let's Encrypt (requiere puertos 80 y 443)
# ip: sin dominio propio; deriva hostname sslip.io y también pide Let's Encrypt (puertos 80 y 443)
# proxy: hay un proxy inverso de la institución delante que termina el TLS. Caddy NO pide certificados
#        ni abre el 443: escucha solo HTTP en CADDY_HTTP_PORT. Exige CERTIFY_PUBLIC_URL.
TLS_MODE=domain

# Solo si TLS_MODE=domain (hostname sin https://)
CERTIFY_PUBLIC_HOST=certify.intrant.gob.do

# Solo si TLS_MODE=ip — IP pública del equipo donde corre Docker (no la LAN 192.168.x.x)
SERVER_PUBLIC_IP=203.0.113.10

# Contacto para Let's Encrypt (obligatorio en domain e ip; no se usa en proxy; no lo entrega OGTIC)
CADDY_ACME_EMAIL=infra@intrant.gob.do

# Solo si TLS_MODE=ip (sslip.io o nip.io)
IP_DNS_PROVIDER=sslip.io

# Solo si TLS_MODE=proxy
# URL pública que sirve SU proxy: https://<dominio>, sin ruta ni barra final (obligatoria en proxy).
# CERTIFY_PUBLIC_URL=https://certify.intrant.gob.do
# Puerto del servidor donde Caddy escucha HTTP para su proxy (por defecto 8080). Es el único que se publica.
# CADDY_HTTP_PORT=8080
# Direcciones/redes (separadas por espacio) cuyo X-Forwarded-For se acepta: las de su proxy. Por defecto
# `private_ranges` (10/8, 172.16/12, 192.168/16, 127/8, ::1, fc00::/7). Su proxy debe enviar
# X-Forwarded-For con la IP real del cliente; de eso depende que el health del actuator no sea público.
# TRUSTED_PROXIES=private_ranges

# --- Institución ---
INSTITUTION_ID=INTRANT
INSTITUTION_DISPLAY_NAME=INTRANT

# --- API de datos (OGTIC) ---
RESTAPI_BASE_URL=https://api.ogtic.gob.do/intrant
# URL del token de la API de datos (RESTAPI_BASE_URL). NO es el token del ciudadano ni el de Cuenta
# Única. OGTIC entrega el valor: sin él el kit no genera nada (no hay valor por defecto).
RESTAPI_TOKEN_URL=
RESTAPI_SCOPE_ENDPOINT_MAPPING="{'openid offline_access profile email': '/:national_id','openid': '/:national_id'}"

# --- OAuth de Cuenta Única (cliente que OGTIC entrega) ---
OAUTH_CLIENT_ID=CAMBIAR-ME
OAUTH_CLIENT_SECRET=REEMPLAZAR_CON_SECRET_DE_OGTIC

# --- Credencial a emitir ---
CREDENTIAL_CONFIG_KEY_ID=DriverLicenseCredential
CREDENTIAL_ATTRIBUTES=national_id,fullName,dateOfBirth,licenseNumber
CREDENTIAL_SCOPE="openid offline_access profile email"
# Logo de la credencial: ruta a un fichero PNG (obligatorio). Una ruta relativa se resuelve desde este
# directorio. El kit lo copia y lo sirve en https://<su dominio>/logos/<CREDENTIAL_CONFIG_KEY_ID>.png.
LOGO_PATH=

# --- Opcionales (el kit aplica defaults si se dejan vacíos) ---
# Servidor de autorización de los ciudadanos: Cuenta Única de producción. SIN barra final (el emisor
# del token se compara tal cual). Solo cámbielo para pruebas contra otro servidor.
# AUTH_ISSUER_URL=https://auth.cuentaunica.gob.do
# CREDENTIAL_DISPLAY_NAME=INTRANT
# Tipos (el kit los guarda ordenados como Certify; VerifiableCredential siempre se incluye).
# CREDENTIAL_TYPE=VerifiableCredential,INTRANTCredential
# CREDENTIAL_FORMAT=ldp_vc
# CREDENTIAL_BG_COLOR=#12107c
# CREDENTIAL_TEXT_COLOR=#FFFFFF
# Etiquetas que ve el ciudadano (JSON, entre comillas simples; puede llevar «:» y acentos).
# Sin etiqueta, se muestra el nombre del atributo. Los nombres de CREDENTIAL_ATTRIBUTES solo admiten
# letras sin acento, dígitos y «_» (sin espacios ni «:»).
# CREDENTIAL_LABELS_JSON='{"national_id":"Cédula","fullName":"Nombre completo","dateOfBirth":"Fecha de nacimiento","licenseNumber":"Número de licencia"}'
# DID_URL=did:web:certify.intrant.gob.do

# --- Build / infra interna (opcional) ---
# Plugin RestAPI: por defecto usa certify-service/loader_path/certify/restapi-dataprovider-plugin-*.jar
# RESTAPI_PLUGIN_JAR=/ruta/alternativa/restapi-dataprovider-plugin.jar
# Contraseñas: si deja los valores por defecto (postgres / local) o los vacía, el kit genera unas
# aleatorias (64 hex) y las guarda solo en generated/.env.runtime (modo 600); no se muestran en ningún
# log. SOLO PARA INSTALACIONES NUEVAS: la de Postgres queda grabada en el volumen de datos y la del
# keystore en el keystore de Certify desde el primer arranque. En una instalación existente fije aquí
# la contraseña que YA tiene la base (distinta de «postgres»; cámbiela antes en la base con ALTER USER),
# o ponga KIT_CONSERVAR_SECRETOS_POR_DEFECTO=1 para que el kit no genere nada. Ver la guía.
POSTGRES_PASSWORD=postgres
KEYSTORE_PASSWORD=local
# KIT_CONSERVAR_SECRETOS_POR_DEFECTO=1
POSTGRES_USER=postgres
POSTGRES_DB=inji_certify
